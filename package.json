{
  "name": "campusconnect-root",
  "version": "1.0.0",
  "description": "CampusConnect - Institutional Event & Notice Board (MERN Stack)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "college",
    "campusconnect",
    "events",
    "notices"
  ],
  "author": "CampusConnect Team",
  "license": "ISC"
}
